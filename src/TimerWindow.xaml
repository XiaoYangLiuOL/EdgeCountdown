<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="贴边倒计时" Width="304" Height="202"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="#151A22" Foreground="#E8EDF5" FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0"
                            GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#7AE6BE"/>
        <SolidColorBrush x:Key="Text" Color="#E8EDF5"/>
        <SolidColorBrush x:Key="Muted" Color="#A8B3C4"/>
        <SolidColorBrush x:Key="Warning" Color="#FFB09B"/>
        <SolidColorBrush x:Key="Panel" Color="#202733"/>
        <SolidColorBrush x:Key="Outline" Color="#354153"/>
        <SolidColorBrush x:Key="Track" Color="#2A3443"/>

        <Style x:Key="CountdownProgress" TargetType="{x:Type ProgressBar}">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="Background" Value="{StaticResource Track}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ButtonSurface" TargetType="{x:Type ButtonBase}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Surface" Property="BorderBrush" Value="#EFF8F7"/>
                    <Setter TargetName="Surface" Property="BorderThickness" Value="1.5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="Action" TargetType="{x:Type Button}">
            <Setter Property="Template" Value="{StaticResource ButtonSurface}"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D3848"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#10251E"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A0F3D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleButton" TargetType="{x:Type ButtonBase}">
            <Setter Property="Template" Value="{StaticResource ButtonSurface}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>

        <Style x:Key="MiniModeToggle" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Pin" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource TitleButton}">
            <Setter Property="ToolTip" Value="开启置顶"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#243B36"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter Property="ToolTip" Value="取消置顶"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Close" TargetType="{x:Type Button}" BasedOn="{StaticResource TitleButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#64343A"/>
                    <Setter Property="Foreground" Value="#FFF0EC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#354153" BorderThickness="1" CornerRadius="9">
        <Grid>
            <Grid x:Name="FullView" Margin="14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="88"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MiniModeButton" Style="{StaticResource MiniModeToggle}" Visibility="Collapsed"
                                ToolTip="缩为迷你模式" AutomationProperties.Name="缩为迷你模式" Margin="0,0,4,0">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M 2,3 L 12,3 L 12,10 L 2,10 Z M 5,7 L 9,7"/>
                        </Button>
                        <ToggleButton x:Name="PinButton" Style="{StaticResource Pin}" IsChecked="True"
                                      AutomationProperties.Name="窗口置顶" Margin="0,0,4,0">
                            <Path Width="13" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M 5,1 L 12,1 L 10,4 L 10,7 L 12,9 L 4,9 L 6,7 L 6,4 Z M 8,9 L 8,14"/>
                        </ToggleButton>
                        <Button x:Name="CloseButton" Style="{StaticResource Close}" ToolTip="隐藏到托盘"
                                AutomationProperties.Name="隐藏到托盘">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="拖动这里可吸附到屏幕边缘">
                        <Border Width="22" Height="22" CornerRadius="7" Background="#243B36">
                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource Accent}"
                                  StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 M 8,4.5 L 8,8 L 10.3,9.5"/>
                        </Border>
                        <TextBlock Text="贴边倒计时" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="43" FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,13,0,0"/>
                    <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                 Style="{StaticResource CountdownProgress}" AutomationProperties.Name="剩余进度"/>
                </Grid>

                <Grid x:Name="EntryControls" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="78"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DurationBox" Text="1.39" FontSize="15" FontFamily="Cascadia Mono, Consolas"
                             AutomationProperties.Name="倒计时时长" AutomationProperties.HelpText="1.39 表示 1 小时 39 分钟，整数表示分钟。"
                             Background="{StaticResource Panel}" Foreground="{StaticResource Text}" Padding="10,0"
                             VerticalContentAlignment="Center" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                             CaretBrush="{StaticResource Accent}" SelectionBrush="#438371"
                             InputMethod.IsInputMethodEnabled="False">
                        <TextBox.Template>
                            <ControlTemplate TargetType="{x:Type TextBox}">
                                <Border x:Name="Field" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Field" Property="BorderBrush" Value="#69BDAC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource Primary}" Content="开始" IsDefault="True"/>
                </Grid>

                <Grid x:Name="RunControls" Grid.Row="2" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ResetButton" Style="{StaticResource Action}" Content="重置"/>
                    <Button x:Name="PauseButton" Grid.Column="2" Style="{StaticResource Primary}" Content="暂停"/>
                </Grid>

                <TextBlock x:Name="HintText" Grid.Row="3" Text="1.39 = 1 小时 39 分钟"
                           FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
            </Grid>
            <Button x:Name="MiniView" Visibility="Collapsed" Background="Transparent" Cursor="Hand"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    ToolTip="单击展开，按住可拖动" AutomationProperties.Name="展开计时器"
                    AutomationProperties.HelpText="单击展开，按住可拖动">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <TextBlock x:Name="MiniTime" Text="{Binding Text, ElementName=TimeText}"
                               Foreground="{Binding Foreground, ElementName=TimeText}"
                               FontSize="26" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="DockProgress" Style="{StaticResource CountdownProgress}"
                                 Value="{Binding Value, ElementName=Progress}" Visibility="Collapsed"
                                 Height="6" Margin="6,0" VerticalAlignment="Center" AutomationProperties.Name="剩余进度"/>
                </Grid>
            </Button>
        </Grid>
    </Border>
</Window>
